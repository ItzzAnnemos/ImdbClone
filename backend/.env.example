# Copy this file to `.env` in the backend directory to override local Docker defaults.
# Docker Compose reads this file automatically only after it is copied to `.env`.

POSTGRES_DB=imdb_clone_app
POSTGRES_USER=imdb
POSTGRES_PASSWORD=imdb
POSTGRES_PORT=2345

# Spring uses the same defaults from application-postgres.properties.
# If you change POSTGRES_PORT or database credentials here, export matching
# values before running Maven, or set POSTGRES_JDBC_URL explicitly.
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:2345/imdb_clone_app

# Optional for local dev. If blank under the dev profile, the backend generates
# an ephemeral JWT key on startup, which invalidates old browser sessions.
# Use a long random value if your team wants stable local tokens across restarts.
JWT_SECRET=
