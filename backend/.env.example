# Copy this file to `.env` in the backend directory to override local Docker defaults.
# Docker Compose reads this file automatically only after it is copied to `.env`.

POSTGRES_DB=imdb_clone_app
POSTGRES_USER=imdb
POSTGRES_PASSWORD=imdb
POSTGRES_PORT=2345

# Spring uses the same defaults from application-postgres.properties.
# If you change POSTGRES_PORT or database credentials here, export matching
# values before running Maven, or set POSTGRES_JDBC_URL explicitly.
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:2345/imdb_clone_app

# Optional for local dev. If blank under the dev profile, the backend generates
# an ephemeral JWT key on startup, which invalidates old browser sessions.
# Use a long random value if your team wants stable local tokens across restarts.
# It can be plain text; at least 32 random characters is recommended.
JWT_SECRET=change_this_to_a_long_random_secret_for_local_dev

# Comma-separated frontend origins allowed to call the API.
# For deployment, set this to your frontend URL, for example:
# APP_CORS_ALLOWED_ORIGINS=https://your-imdb-clone.vercel.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TMDB import. The backend reads backend/.env automatically when run from the
# backend directory. Use the v4 Read Access Token, not the shorter v3 API key.
TMDB_ENABLED=true
TMDB_API_TOKEN=your_v4_read_access_token
TMDB_MAX_MOVIES=500
TMDB_MAX_TV_SERIES=300
TMDB_PAGES=25
TMDB_DISCOVERY_SORTS=popularity.desc,vote_average.desc,vote_count.desc,primary_release_date.desc
TMDB_TV_DISCOVERY_SORTS=popularity.desc,vote_average.desc,vote_count.desc,first_air_date.desc
TMDB_MINIMUM_VOTE_COUNT=200
TMDB_MAX_CAST=10
